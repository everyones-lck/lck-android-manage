<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="20dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_comment"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/layout_comment_nickname_date">

        <ImageView
            android:id="@+id/iv_comment_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_logo"
            android:scaleType="centerCrop"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_comment_nickname_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12.dp"
        app:layout_constraintStart_toEndOf="@id/cv_comment"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_comment_nickname"
            style="@style/TextAppearance.LCK.Bold.Detail_10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="모두의 LCK"/>
        <TextView
            style="@style/TextAppearance.LCK.Bold.Detail_10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            tools:text="|"/>
        <TextView
            android:id="@+id/tv_comment_supportTeam"
            style="@style/TextAppearance.LCK.Bold.Detail_10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="KT"/>
        <View
            android:layout_width="5dp"
            android:layout_height="0dp"/>
        <TextView
            android:id="@+id/tv_comment_date"
            style="@style/TextAppearance.LCK.Light.Comment_8sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="2024.07,01"/>
    </LinearLayout>


    <TextView
        android:id="@+id/tv_comment_body"
        style="@style/TextAppearance.LCK.Light.Detail_10sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="모두의 마블"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/layout_comment_nickname_date"
        app:layout_constraintTop_toBottomOf="@id/layout_comment_nickname_date" />

    <TextView
        android:id="@+id/tv_comment_report_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.LCK.Bold.List_14sp"
        android:textColor="@color/warning"
        android:text="0"
        app:layout_constraintTop_toTopOf="@id/cv_comment"
        app:layout_constraintBottom_toBottomOf="@id/cv_comment"
        app:layout_constraintEnd_toStartOf="@id/iv_report_comment_btn"
        android:layout_marginEnd="12dp"/>

    <ImageView
        android:id="@+id/iv_report_comment_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_report"
        app:layout_constraintBottom_toBottomOf="@id/cv_comment"
        app:layout_constraintEnd_toStartOf="@id/iv_comment_delete_btn"
        app:layout_constraintTop_toTopOf="@id/cv_comment" />

    <ImageView
        android:id="@+id/iv_comment_delete_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:src="@drawable/ic_delete"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cv_comment"
        app:layout_constraintBottom_toBottomOf="@id/cv_comment"/>

</androidx.constraintlayout.widget.ConstraintLayout>